# Скопируйте в .env и поменяйте пароли
POSTGRES_DB=ohs
POSTGRES_USER=ohs_owner
POSTGRES_PASSWORD=change_me_owner
OHS_APP_PASSWORD=change_me_app

# Секрет для подписи токенов (длинная случайная строка)
SECRET_KEY=change_me_long_random_string

# Первый суперадминистратор (создаётся командой из README)
SUPERADMIN_PHONE=+79990000000
SUPERADMIN_PASSWORD=ChangeMe_12345
SUPERADMIN_NAME=Администратор системы

# Куда складывать файлы (на хостинге можно заменить на S3 позже)
STORAGE_DIR=/app/storage
